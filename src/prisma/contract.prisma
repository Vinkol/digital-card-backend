// use prisma-8

model Profile {
  id          Int          @id @default(autoincrement())
  name        String
  title       String
  description String
  location    String?
  email       String?
  githubUrl   String?
  linkedinUrl String?
  skills      Skill[]
  experience  Experience[]
  projects    Project[]
}

model Skill {
  id        Int     @id @default(autoincrement())
  name      String
  category  String?
  profileId Int
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Experience {
  id           Int      @id @default(autoincrement())
  company      String
  position     String
  period       String
  achievements String[]
  profileId    Int
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  liveUrl     String?
  repoUrl     String?
  techStack   String[]
  profileId   Int
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}
